# PostgreSQL: DATABASE_URL wins if set; otherwise use the discrete PG* vars.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=bugflows

# Used to sign the login token. Change this for any real deployment.
JWT_SECRET=replace_with_a_long_random_secret

PORT=4000

# Milestone 4: connection pool sizing (defaults are fine for local dev/tests;
# raise PG_POOL_MAX for a production deployment at scale)
PG_POOL_MAX=30
PG_POOL_MIN=5
